<?php

namespace {{ namespace }};

use Xenio\LivewireForms\Fields\Submit;
use Xenio\LivewireForms\Fields\TextInput;
use Xenio\LivewireForms\Form;

class {{ class }} extends Form
{
    /**
     * Named route the form submits to.
     */
    protected ?string $actionRoute = null;

    /**
     * @return array<int, \Xenio\LivewireForms\Fields\Field|\Xenio\LivewireForms\Fields\Fieldset>
     */
    public function fields(): array
    {
        return [
            TextInput::make('name')->required(),
            Submit::make('Save'),
        ];
    }
}
