{
    "name": "vtyumencev/livewire-forms",
    "description": "Define Laravel forms in PHP and render them with Livewire. Validation, conditional visibility, authorization, and model binding included.",
    "keywords": [
        "laravel",
        "livewire",
        "forms",
        "form-builder",
        "blade",
        "tailwind",
        "validation"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [

    ],
    "support": {

    },
    "funding": [

    ],
    "require": {
        "php": "^8.3",
        "illuminate/auth": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Xenio\\LivewireForms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Xenio\\LivewireForms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Xenio\\LivewireForms\\LivewireFormsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
